# --- Chat model (Groq, free) ---------------------------------------------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Groq retires models; list what your key can use with
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# CHAT_MODEL=openai/gpt-oss-120b
# Used when CHAT_MODEL is rate-limited (separate quota) or has been retired.
# CHAT_FALLBACK_MODEL=openai/gpt-oss-20b
# Optional: OpenAI-compatible endpoint override (defaults to Groq).
# GROQ_URL=https://api.groq.com/openai/v1/chat/completions

# --- Site ------------------------------------------------------------------
# Absolute origin used in auth emails (confirm / reset links). Set it in
# production; without it the app trusts the request Host header.
NEXT_PUBLIC_SITE_URL=https://supportchat.example.com

# --- Supabase -------------------------------------------------------------
# Public keys (browser + server auth). Supabase -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Server-only. Used by /api/chat to read any bot's config for answering.
# NEVER expose the service role key to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret
